# ============================================
# MIXIMAGE AI 2026 - Environment Configuration
# ============================================

# ============================================
# LOVABLE CLOUD CONFIGURATION
# ============================================
# These are auto-configured when using Lovable Cloud
# For local development, get these from your Lovable project settings

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (safe to expose in frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Project ID (optional)
VITE_SUPABASE_PROJECT_ID=your-project-id

# ============================================
# LOVABLE AI API
# ============================================
# Used for AI Gateway access (Gemini models, image generation)
# Get this from: https://lovable.dev - Account Settings > API Keys

LOVABLE_API_KEY=your-lovable-api-key-here

# ============================================
# EXTERNAL API KEYS (Edge Functions)
# ============================================
# These are stored as secrets in Lovable Cloud
# Do NOT commit actual values to version control

# Perplexity API (for search/research features)
# PERPLEXITY_API_KEY=your-perplexity-api-key

# ============================================
# APPLICATION SETTINGS
# ============================================

# App name (display purposes)
VITE_APP_NAME=MIX IMAGE AI 2026

# Environment: development | production
VITE_ENV=development

# Optional: Enable debug logging
# VITE_DEBUG=true

# Optional: Max image upload size (bytes)
# VITE_MAX_UPLOAD_SIZE=10485760  # 10MB

# Optional: API timeout (milliseconds)
# VITE_API_TIMEOUT=30000  # 30 seconds

# ============================================
# NOTES
# ============================================
# 1. Copy this file to .env.local for development
# 2. Never commit .env.local to version control
# 3. Keep API keys secure - rotate if exposed
# 4. Lovable Cloud auto-manages most env vars
# 5. Edge function secrets are managed via Lovable UI
